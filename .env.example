# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_ENV=development

# Database
DATABASE_URL=postgres://envsend:envsend@localhost:5432/envsend?sslmode=disable
DATABASE_MAX_CONNECTIONS=25
DATABASE_MAX_IDLE_CONNECTIONS=5

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# MinIO / S3
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=envsend-secrets
S3_USE_SSL=false
S3_REGION=us-east-1

# Security
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60s
MAX_SECRET_SIZE=10485760
DEFAULT_SECRET_EXPIRY=10m
MAX_SECRET_EXPIRY=168h

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Worker
WORKER_CLEANUP_INTERVAL=60s
WORKER_BATCH_SIZE=100

# Enterprise (optional)
ENABLE_ORGANIZATIONS=false
ENABLE_SSO=false
SSO_PROVIDER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# Monitoring (optional)
METRICS_ENABLED=true
METRICS_PORT=9090
TRACING_ENABLED=false
TRACING_ENDPOINT=
