# ==============================================================================
# EnvSend Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_ENV=production

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# For Render: Use the "Internal Database URL" from your PostgreSQL service
# Format: postgres://user:password@host:5432/database?sslmode=require
DATABASE_URL=postgres://envsend:envsend@localhost:5432/envsend?sslmode=disable
DATABASE_MAX_CONNECTIONS=10
DATABASE_MAX_IDLE_CONNECTIONS=2

# ------------------------------------------------------------------------------
# Redis (Upstash)
# ------------------------------------------------------------------------------
# Get this from Upstash Console after creating your database
# Format: rediss://default:password@host:6379
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# S3 Storage (Local Disk for Free Tier)
# ------------------------------------------------------------------------------
# Option A: Local Disk (Free) - Leave S3_ENDPOINT empty
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=local
S3_USE_SSL=false
S3_REGION=

# Option B: Cloudflare R2 (10GB Free)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=<your-r2-access-key>
# S3_SECRET_KEY=<your-r2-secret-key>
# S3_BUCKET=envsend-secrets
# S3_USE_SSL=true
# S3_REGION=auto

# ------------------------------------------------------------------------------
# Security Settings
# ------------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60s
MAX_SECRET_SIZE=10485760
DEFAULT_SECRET_EXPIRY=10m
MAX_SECRET_EXPIRY=168h

# ------------------------------------------------------------------------------
# CORS Configuration
# ------------------------------------------------------------------------------
# Add your frontend URLs (comma-separated, no spaces)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
CORS_ALLOWED_METHODS=GET,POST,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# ------------------------------------------------------------------------------
# Worker Configuration (Background Jobs)
# ------------------------------------------------------------------------------
WORKER_CLEANUP_INTERVAL=60s
WORKER_BATCH_SIZE=100

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
